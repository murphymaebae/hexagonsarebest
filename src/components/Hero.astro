---
---
<section style="position: relative; min-height: 100vh; display: flex; align-items: center; padding-top: 80px; overflow: hidden;">
  <!-- Background Elements -->
  <div style="position: absolute; top: 20%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(255, 140, 198, 0.4) 0%, rgba(255, 140, 198, 0) 70%); border-radius: 50%; filter: blur(60px); z-index: -1;"></div>
  
  <div class="container" style="position: relative; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center;">
    
    <!-- Left Content -->
    <div style="z-index: 2;">
      <h1 class="text-gradient" style="font-size: 5rem; line-height: 0.9; margin-bottom: 2rem; text-transform: uppercase;">
        Innovation<br>
        <span style="font-weight: 300; opacity: 0.8;">of Smarter</span><br>
        AI Solutions
      </h1>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem;">
        <div class="glass" style="padding: 1.5rem; border-radius: 12px;">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #ff8cc6, #d55eaa); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
             <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 style="font-size: 2.5rem; margin-bottom: 0.2rem;">124+</h3>
          <p style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7;">Project Completed</p>
        </div>

        <div class="glass" style="padding: 1.5rem; border-radius: 12px; position: relative;">
          <div style="position: absolute; top: 1rem; right: 1rem; width: 8px; height: 8px; background: #fff; border-radius: 50%;"></div>
          <h3 style="font-size: 2.5rem; margin-bottom: 0.2rem; margin-top: 2rem;">72+</h3>
          <p style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7;">Professional Teams</p>
        </div>
      </div>
    </div>

    <!-- Right Content (Image) -->
    <div style="position: relative; height: 80vh; display: flex; align-items: center; justify-content: center;">
        <img src="/assets/images/hero_character.png" alt="AI Character" class="animate-float" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: drop-shadow(0 0 30px rgba(213, 94, 170, 0.4));" />
        
        <!-- Floating Right Card -->
        <div class="glass" style="position: absolute; top: 10%; right: 0; padding: 2rem; border-radius: 0; width: 200px; text-align: left;">
            <h3 style="font-size: 3rem; font-weight: 300; margin-bottom: 1rem;">30X</h3>
            <p style="font-size: 0.8rem; line-height: 1.4; opacity: 0.8; text-transform: uppercase;">AI Solutions can handle 10x more data as businesses scale.</p>
        </div>

        <!-- Bottom Actions -->
        <div style="position: absolute; bottom: 5%; left: 0; display: flex; gap: 1rem;">
             <button class="glass" style="width: 50px; height: 50px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.3s;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4V8z"/></svg>
             </button>
             <button class="glass" style="width: 50px; height: 50px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: #fff; color: #d55eaa; cursor: pointer;">
                 <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
             </button>
             <div style="margin-left: 1rem;">
                 <h4 style="font-size: 0.9rem; text-transform: uppercase;">AI Solutions<br>Tailored To<br>Your Needs.</h4>
             </div>
        </div>
        
        <div style="position: absolute; bottom: 5%; right: 0;">
             <button class="glass" style="width: 50px; height: 50px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #ff8cc6, #d55eaa); border: none; cursor: pointer;">
                 <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
             </button>
        </div>
    </div>
  </div>
    
  <div style="position: absolute; bottom: 2rem; right: 4rem; max-width: 300px; text-align: right; opacity: 0.7; font-size: 0.8rem;">
      <p>WITH A TEAM OF FORWARD-THINKERS AND INDUSTRY EXPERTS, WE'RE REDEFINING WHAT'S POSSIBLE—ONE ALGORITHM AT A TIME.</p>
  </div>
</section>

<style>
  /* Specific styling tweaks for responsive if needed */
  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr !important;
      text-align: center;
    }
    h1 {
      font-size: 3rem !important;
    }
  }
</style>
